{
  "openapi": "3.1.0",
  "info": { "title": "Fictional order totals", "version": "1.0.0" },
  "paths": { "/orders/summary": { "get": {
    "operationId": "orderSummary", "summary": "Read a fictional order total",
    "responses": { "200": { "description": "Order total", "content": { "application/json": {
      "schema": { "type": "object", "required": ["total"], "properties": { "total": { "type": "number" } } },
      "example": { "total": 42 }
    } } } }
  } } }
}
