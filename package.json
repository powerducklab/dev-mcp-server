{
  "name": "@powerduck/dev-mcp-server",
  "version": "0.7.11",
  "description": "Developer-facing MCP server that gives AI coding agents accurate OpenAPI facts and runs contract/scenario tests against a local backend. Build APIs correctly, verify them immediately.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "powerduck-dev-mcp": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json",
    "bundle": "tsup",
    "build": "npm run clean && npm run typecheck && npm run bundle",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm run test"
  },
  "keywords": [
    "openapi",
    "mcp",
    "model-context-protocol",
    "ai",
    "coding-agent",
    "claude",
    "codex",
    "cursor",
    "backend",
    "contract-testing",
    "scenario-testing",
    "data-modeling",
    "developer-tools"
  ],
  "author": "Powerduck limited",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/powerducklab/dev-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/powerducklab/dev-mcp-server/issues"
  },
  "homepage": "https://www.powerduck.com/",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@powerduck/datamodel": "^0.2.4",
    "@powerduck/openapi-cli": "0.2.15",
    "@powerduck/openapi-parser": "^0.3.10",
    "@powerduck/openapi-request": "0.2.18",
    "ajv": "^8.17.1",
    "commander": "^12.1.0",
    "js-yaml": "^5.4.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.1",
    "terser": "^5.51.2",
    "tsup": "^8.5.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.0"
  }
}
